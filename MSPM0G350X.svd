                <register>
                    <name>MATHACL_STATUSCLR</name>
                    <description>Status flag clear register</description>
                    <addressOffset>0x1140</addressOffset>
                    <size>32</size>
                    <access>write-only</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>CLR_OVF</name>
                            <description>Write 1 to this bit to clear STATUS.OVF bit</description>
                            <bitOffset>0x1</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>NO_EFFECT</name>
                                        <description>Writing 0 has no effect</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
