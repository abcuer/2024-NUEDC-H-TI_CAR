                            </field>
                        <field>
                            <name>NUMITER</name>
                            <description>Number of iterations, applicable if the function does the computations iteratively, for example sine/cosine/atan2/sqrt.
Note: A value of 0 is interpreted as 31.</description>
                            <bitOffset>0x18</bitOffset>
                            <bitWidth>0x5</bitWidth>
                            </field>
                        <field>
                            <name>SFACTOR</name>
