                    <addressOffset>0x13F4</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <fields>
                        <field>
                            <name>DATAWIDTH</name>
                            <description>Data width in bits</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x8</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>W64BIT</name>
                                        <description>Data width is 64 bits</description>
                                        <value>0x40</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>W128BIT</name>
                                        <description>Data width is 128 bits</description>
                                        <value>0x80</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>ECCWIDTH</name>
                            <description>ECC data width in bits</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x5</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>W0BIT</name>
                                        <description>ECC data width is 0.  ECC not used.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>W8BIT</name>
                                        <description>ECC data width is 8 bits</description>
                                        <value>0x8</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>W16BIT</name>
                                        <description>ECC data width is 16 bits</description>
                                        <value>0x10</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>REDWIDTH</name>
                            <description>Redundant data width in bits</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x3</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>W0BIT</name>
                                        <description>Redundant data width is 0.  Redundancy/Repair not present.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>W2BIT</name>
                                        <description>Redundant data width is 2 bits</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>W4BIT</name>
                                        <description>Redundant data width is 4 bits</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                    </fields>
                </register>
                <register>
                    <name>FLASHCTL_GBLINFO2</name>
                    <description>Global Information Register 2</description>
                    <addressOffset>0x13F8</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <fields>
                        <field>
                            <name>DATAREGISTERS</name>
                            <description>Number of data registers present.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x4</bitWidth>
                            <access>read-only</access>
                            </field>
                    </fields>
                </register>
                <register>
                    <name>FLASHCTL_BANK0INFO0</name>
                    <description>Bank Information Register 0 for Bank 0</description>
                    <addressOffset>0x1400</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <fields>
                        <field>
                            <name>MAINSIZE</name>
                            <description>Main region size in sectors
Minimum:	0x8 (8)
Maximum:	0x200 (512)</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0xC</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>MINSECTORS</name>
                                        <description>Minimum value of [MAINSIZE]</description>
                                        <value>0x8</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>MAXSECTORS</name>
                                        <description>Maximum value of [MAINSIZE]</description>
                                        <value>0x200</value>
