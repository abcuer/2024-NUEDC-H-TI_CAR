                                        <description>No Error in computation.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>DIVBY0</name>
                                        <description>DIVBY0 error</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
