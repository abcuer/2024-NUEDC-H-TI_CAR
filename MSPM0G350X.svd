                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x6</bitWidth>
                            </field>
                        <field>
                            <name>SATEN</name>
                            <description>Saturation enable
This bit is shared among DIV, SQUARE32, MPY32, MAC and SAC functions.
When enabled, it will make the result to saturate to maximum value in case of an overflow event
When disabled, the result will overflow to an unknown value.</description>
                            <bitOffset>0x16</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DISABLE</name>
                                        <description>Saturation is disabled</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ENABLE</name>
                                        <description>Saturation is enabled</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
