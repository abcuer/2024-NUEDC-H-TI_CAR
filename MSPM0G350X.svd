                                        <enumeratedValue>
                                            <name>CCP_HIGH</name>
                                            <description>CCP output value is set high</description>
                                            <value>0x1</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>CCP_LOW</name>
                                            <description>CCP output value is set low</description>
                                            <value>0x2</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
