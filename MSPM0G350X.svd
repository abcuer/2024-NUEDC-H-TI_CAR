                                <bitOffset>0x0</bitOffset>
                                <bitWidth>0x7</bitWidth>
                                <access>read-only</access>
                                </field>
                            <field>
                                <name>F1GI</name>
                                <description>Rx FIFO 1 Get Index. Rx FIFO 1 read index pointer, range 0 to 63.</description>
                                <bitOffset>0x8</bitOffset>
                                <bitWidth>0x6</bitWidth>
