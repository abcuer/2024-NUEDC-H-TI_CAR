                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT1</name>
                                        <description>1 bit shift</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT2</name>
                                        <description>2 bit shift</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT3</name>
                                        <description>3 bit shift</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT4</name>
                                        <description>4 bit shift</description>
                                        <value>0x4</value>
