                            <description>Overflow bit for MPY32, SQUARE32, DIV, MAC, and SAC functions
This bit will be set on overflow and will retain its value until cleared by writing 1 into CLR.CLR_OVF</description>
                            <bitOffset>0x1</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                            </field>
                        <field>
                            <name>ERR</name>
                            <description>Incorrect inputs/outputs.</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
