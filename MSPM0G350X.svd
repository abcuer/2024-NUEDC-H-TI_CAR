                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>LOWCTIVE</name>
                                            <description>Fault Input is active low.</description>
                                            <value>0x0</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>HIGHACTIVE</name>
                                            <description>Fault Input is active high.</description>
