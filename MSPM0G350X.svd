                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>LOWCTIVE</name>
                                            <description>Fault Input is active low.</description>
                                            <value>0x0</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>HIGHACTIVE</name>
                                            <description>Fault Input is active high.</description>
                                            <value>0x1</value>
                                        </enumeratedValue>
                                    </enumeratedValues>
                                </field>
                            <field>
                                <name>FSENAC1</name>
                                <description>Specifies whether the analog comparator1 fault sense is high or low active</description>
                                <bitOffset>0x9</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>LOWCTIVE</name>
                                            <description>Fault Input is active low.</description>
