                    <register>
                        <name>TIMA0_FCTL</name>
                        <description>Fault Control Register</description>
                        <addressOffset>0xD0</addressOffset>
                        <size>32</size>
                        <access>read-write</access>
                        <fields>
                            <field>
                                <name>FIEN</name>
                                <description>Fault Input Enable
This bit enables the input for fault detection.</description>
                                <bitOffset>0x0</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>DISABLED</name>
                                            <description>Fault Input Disabled</description>
                                            <value>0x0</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>ENABLED</name>
                                            <description>Fault Input Enabled</description>
                                            <value>0x1</value>
                                        </enumeratedValue>
                                    </enumeratedValues>
                                </field>
                            <field>
                                <name>FI</name>
                                <description>Fault Input
Specifies whether the overall fault condition is dependent on the sensed fault pin.</description>
                                <bitOffset>0x2</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>INDEPENDENT</name>
                                            <description>Overall Fault condition is not dependent on sensed input.</description>
                                            <value>0x0</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>DEPENDENT</name>
                                            <description>Overall Fault condition is dependent on sensed input.</description>
                                            <value>0x1</value>
                                        </enumeratedValue>
                                    </enumeratedValues>
                                </field>
                            <field>
                                <name>TFIM</name>
                                <description>Trigger Fault Input Mask
Specifies whether the selected trigger participates as a fault input. If enabled and the trigger asserts, the trigger is treated as a fault.</description>
                                <bitOffset>0x7</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>DISABLED</name>
                                            <description>Selected trigger does not participate in fault condition generation</description>
                                            <value>0x0</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>ENABLED</name>
                                            <description>Selected trigger participates in fault condition generation</description>
                                            <value>0x1</value>
                                        </enumeratedValue>
                                    </enumeratedValues>
                                </field>
                            <field>
                                <name>FL</name>
                                <description>Fault Latch mode
Specifies whether the fault condition is latched and configures the latch clear conditions.</description>
                                <bitOffset>0x3</bitOffset>
                                <bitWidth>0x2</bitWidth>
                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>NO_LATCH</name>
                                            <description>Overall fault condition is not dependent on the F bit in RIS</description>
                                            <value>0x0</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>LATCH_SW_CLR</name>
                                            <description>Overall fault condition is dependent on the F bit in RIS</description>
                                            <value>0x1</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>LATCH_Z_CLR</name>
                                            <description>Fault condition is latched. Fault condition is cleared on a zero event if the fault input is 0.</description>
                                            <value>0x2</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>LATCH_LD_CLR</name>
                                            <description>Fault condition is latched. Fault condition is cleared on a load event if the fault input is 0.</description>
                                            <value>0x3</value>
                                        </enumeratedValue>
                                    </enumeratedValues>
                                </field>
                            <field>
                                <name>FSENAC0</name>
                                <description>Specifies whether the analog comparator0 fault sense is high or low active</description>
                                <bitOffset>0x8</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>LOWCTIVE</name>
                                            <description>Fault Input is active low.</description>
                                            <value>0x0</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>HIGHACTIVE</name>
                                            <description>Fault Input is active high.</description>
                                            <value>0x1</value>
                                        </enumeratedValue>
                                    </enumeratedValues>
                                </field>
                            <field>
                                <name>FSENAC1</name>
                                <description>Specifies whether the analog comparator1 fault sense is high or low active</description>
                                <bitOffset>0x9</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>LOWCTIVE</name>
                                            <description>Fault Input is active low.</description>
                                            <value>0x0</value>
                                        </enumeratedValue>
                                        <enumeratedValue>
                                            <name>HIGHACTIVE</name>
                                            <description>Fault Input is active high.</description>
                                            <value>0x1</value>
                                        </enumeratedValue>
                                    </enumeratedValues>
                                </field>
                            <field>
                                <name>FSENAC2</name>
                                <description>Specifies whether the analog comparator2 fault sense is high or low active</description>
                                <bitOffset>0xA</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <access>read-write</access>
                                <enumeratedValues>
                                        <enumeratedValue>
                                            <name>LOWCTIVE</name>
                                            <description>Fault Input is active low.</description>
